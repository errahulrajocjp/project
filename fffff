package vzw.pos.wsclient.cxp.domain.model.shopping.cart;

import java.io.Serializable;

public enum CartCustomerType implements Serializable {
    /**
     * N- New Customer
     */
    N,
    
    /**
     * U - upgrade customer
     */
    U,
    
    /**
     * E - customer adding lines to existing account  
     */
    E,
    
    /**
     * P - Previous customer rejoining verizon wireless
     */
    P,
    
    /**
     * C - Combo - multiple customer types in a cart.
     */
    C;
    
    private final static long serialVersionUID = 1L;
    
    public String value() {
        return name();
    }
    
    public static CartCustomerType fromValue(String v) {
        return valueOf(v);
    }
}

