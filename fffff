// CartOrderHeaderConverter.java
package vzw.pos.wsclient.cxp.domain.cartconverter;

import org.springframework.stereotype.Component;

@Component
public class CartOrderHeaderConverter {
    public void convertCartOrderHeader(Cart nsaCart, vzw.pos.wsclient.posservicesws.generated.common.Cart b360Cart) {
        CartOrderHeader nsaCartOrderHeader = nsaCart.getOrderDetails();
        vzw.pos.wsclient.posservicesws.generated.common.CartOrderHeader b360CartOrderHeader = new vzw.pos.wsclient.posservicesws.generated.common.CartOrderHeader();
        
        if (nsaCartOrderHeader != null) {
            // Map customer and account information
            if (nsaCartOrderHeader.getCustomerType() != null) {
                b360CartOrderHeader.setCustomerType(nsaCartOrderHeader.getCustomerType().value());
            }
            b360CartOrderHeader.setUserType(nsaCartOrderHeader.getUserType());
            b360CartOrderHeader.setAccountType(nsaCartOrderHeader.getAccountType());
            b360CartOrderHeader.setLocationCode(nsaCartOrderHeader.getLocationCode());
            b360CartOrderHeader.setRegionId(nsaCartOrderHeader.getRegionId());
            b360CartOrderHeader.setBillingSystem(nsaCartOrderHeader.getBillingSystem());
            b360CartOrderHeader.setPaperlessInd(nsaCartOrderHeader.getPaperlessInd());
            
            // Map credit and financial information
            b360CartOrderHeader.setCreditApprovalStatus(nsaCartOrderHeader.getCreditApprovalStatus());
            b360CartOrderHeader.setCreditStatusReason(nsaCartOrderHeader.getCreditStatusReason());
            b360CartOrderHeader.setCreditAdvisory(nsaCartOrderHeader.getCreditAdvisory());
            b360CartOrderHeader.setCreditClass(nsaCartOrderHeader.getCreditClass());
            b360CartOrderHeader.setSecurityDepositAmount(nsaCartOrderHeader.getSecurityDepositAmount());
            b360CartOrderHeader.setFwaSecurityDepositAmount(nsaCartOrderHeader.getFwaSecurityDepositAmount());
            
            // Map order details
            b360CartOrderHeader.setPurchaseOrderNumber(nsaCartOrderHeader.getPurchaseOrderNumber());
            b360CartOrderHeader.setFraudLevel(nsaCartOrderHeader.getFraudLevel());
            b360CartOrderHeader.setSpocs(nsaCartOrderHeader.getSpocs());
            
            // Map financial amounts
            b360CartOrderHeader.setTotalDueTodayFlag(nsaCartOrderHeader.isTotalDueTodayFlag());
            b360CartOrderHeader.setTotalDueToday(nsaCartOrderHeader.getTotalDueToday());
            b360CartOrderHeader.setRunningTotalDueToday(nsaCartOrderHeader.getRunningTotalDueToday());
            b360CartOrderHeader.setSubTotalDueToday(nsaCartOrderHeader.getSubTotalDueToday());
            b360CartOrderHeader.setTotalUpgradeFee(nsaCartOrderHeader.getTotalUpgradeFee());
            b360CartOrderHeader.setShellAccountNumber(nsaCartOrderHeader.getShellAccountNumber());
            
            // Map monthly amounts
            b360CartOrderHeader.setTotalDueMonthly(nsaCartOrderHeader.getTotalDueMonthly());
            b360CartOrderHeader.setSubTotalDueMonthly(nsaCartOrderHeader.getSubTotalDueMonthly());
            b360CartOrderHeader.setSubTotalMonthlyTaxes(nsaCartOrderHeader.getSubTotalMonthlyTaxes());
            b360CartOrderHeader.setTotalMonthlyTaxes(nsaCartOrderHeader.getTotalMonthlyTaxes());
            b360CartOrderHeader.setSubTotalOtherLines(nsaCartOrderHeader.getSubTotalOtherLines());
            b360CartOrderHeader.setSubTotalOtherLinesTaxes(nsaCartOrderHeader.getSubTotalOtherLinesTaxes());
            
            // Map charge summary and other details
            b360CartOrderHeader.setChargeSummary(nsaCartOrderHeader.getChargeSummary());
        }
        
        // Set the converted header to the b360Cart
        b360Cart.setOrderDetails(b360CartOrderHeader);
    }
}

