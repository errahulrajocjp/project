package vzw.pos.wsclient.cxp.domain.cartconverter;

import org.springframework.stereotype.Component;

@Component
public class CartOrderHeaderConverter {
    public void convertCartOrderHeader(Cart nsaCart, vzw.pos.wsclient.posservicesws.generated.common.Cart b360Cart) {
        CartOrderHeader nsaCartOrderHeader = nsaCart.getOrderDetails();
        vzw.pos.wsclient.posservicesws.generated.common.CartOrderHeader b360CartOrderHeader = new vzw.pos.wsclient.posservicesws.generated.common.CartOrderHeader();
        
        if (nsaCartOrderHeader != null) {
            // Map customer and account information
            if (nsaCartOrderHeader.getCustomerType() != null) {
                b360CartOrderHeader.setCustomerType(nsaCartOrderHeader.getCustomerType().value());
            }
            b360CartOrderHeader.setUserType(nsaCartOrderHeader.getUserType());
            b360CartOrderHeader.setAccountType(nsaCartOrderHeader.getAccountType());
            b360CartOrderHeader.setLocationCode(nsaCartOrderHeader.getLocationCode());
            b360CartOrderHeader.setRegionId(nsaCartOrderHeader.getRegionId());
            b360CartOrderHeader.setLocationState(nsaCartOrderHeader.getLocationState());
            b360CartOrderHeader.setHomeLocation(nsaCartOrderHeader.getHomeLocation());
            b360CartOrderHeader.setOrderType(nsaCartOrderHeader.getOrderType());
            b360CartOrderHeader.setCartType(nsaCartOrderHeader.getCartType());
            b360CartOrderHeader.setBillingSystem(nsaCartOrderHeader.getBillingSystem());
            b360CartOrderHeader.setPaperlessInd(nsaCartOrderHeader.getPaperlessInd());
            
            // Map credit and financial information
            b360CartOrderHeader.setCreditApprovalStatus(nsaCartOrderHeader.getCreditApprovalStatus());
            b360CartOrderHeader.setCreditStatusReason(nsaCartOrderHeader.getCreditStatusReason());
            b360CartOrderHeader.setCreditAdvisory(nsaCartOrderHeader.getCreditAdvisory());
            b360CartOrderHeader.setCreditClass(nsaCartOrderHeader.getCreditClass());
            b360CartOrderHeader.setSecurityDepositAmount(nsaCartOrderHeader.getSecurityDepositAmount());
            b360CartOrderHeader.setFwaSecurityDepositAmount(nsaCartOrderHeader.getFwaSecurityDepositAmount());
            
            // Map tax information
            b360CartOrderHeader.setTaxSystem(nsaCartOrderHeader.getTaxSystem());
            b360CartOrderHeader.setTotalTaxAmount(nsaCartOrderHeader.getTotalTaxAmount());
            
            // Map order details
            b360CartOrderHeader.setPurchaseOrderNumber(nsaCartOrderHeader.getPurchaseOrderNumber());
            b360CartOrderHeader.setFraudLevel(nsaCartOrderHeader.getFraudLevel());
            b360CartOrderHeader.setDeviceRecycleAttempted(nsaCartOrderHeader.getDeviceRecycleAttempted());
            b360CartOrderHeader.setExplicitSaveInd(nsaCartOrderHeader.getExplicitSaveInd());
            b360CartOrderHeader.setSpocs(nsaCartOrderHeader.getSpocs());
            
            // Map financial amounts
            b360CartOrderHeader.setTotalDueTodayFlag(nsaCartOrderHeader.isTotalDueTodayFlag());
            b360CartOrderHeader.setTotalDueToday(nsaCartOrderHeader.getTotalDueToday());
            b360CartOrderHeader.setRunningTotalDueToday(nsaCartOrderHeader.getRunningTotalDueToday());
            b360CartOrderHeader.setSubTotalDueToday(nsaCartOrderHeader.getSubTotalDueToday());
            b360CartOrderHeader.setSubTotalDueTodayWithoutUpgradeFee(nsaCartOrderHeader.getSubTotalDueTodayWithoutUpgradeFee());
            b360CartOrderHeader.setTotalUpgradeFee(nsaCartOrderHeader.getTotalUpgradeFee());
            b360CartOrderHeader.setTotalETAEligibleAmount(nsaCartOrderHeader.getTotalETAEligibleAmount());
            b360CartOrderHeader.setShellAccountNumber(nsaCartOrderHeader.getShellAccountNumber());
            b360CartOrderHeader.setTotalNonETACharges(nsaCartOrderHeader.getTotalNonETACharges());
            
            // Map monthly amounts
            b360CartOrderHeader.setTotalDueMonthly(nsaCartOrderHeader.getTotalDueMonthly());
            b360CartOrderHeader.setSubTotalDueMonthly(nsaCartOrderHeader.getSubTotalDueMonthly());
            b360CartOrderHeader.setSubTotalDueMonthlyForAALBYODEUP(nsaCartOrderHeader.getSubTotalDueMonthlyForAALBYODEUP());
            b360CartOrderHeader.setSubTotalMonthlyTaxes(nsaCartOrderHeader.getSubTotalMonthlyTaxes());
            b360CartOrderHeader.setTotalMonthlyTaxes(nsaCartOrderHeader.getTotalMonthlyTaxes());
            b360CartOrderHeader.setSubTotalOtherLines(nsaCartOrderHeader.getSubTotalOtherLines());
            b360CartOrderHeader.setSubTotalOtherLinesTaxes(nsaCartOrderHeader.getSubTotalOtherLinesTaxes());
            b360CartOrderHeader.setEstimatedNextMonthCharge(nsaCartOrderHeader.getEstimatedNextMonthCharge());
            
            // Map charge summary and other details
            b360CartOrderHeader.setChargeSummary(nsaCartOrderHeader.getChargeSummary());
            b360CartOrderHeader.setInstantRRCCredit(nsaCartOrderHeader.isInstantRRCCredit());
            b360CartOrderHeader.setTradeAtHome(nsaCartOrderHeader.getTradeAtHome());
            
            // Map additional properties from File 1 (33 properties)
            b360CartOrderHeader.setManagerApprovalRequired(nsaCartOrderHeader.isManagerApprovalRequired());
            b360CartOrderHeader.setIsAttachmentCompleted(nsaCartOrderHeader.isIsAttachmentCompleted());
            b360CartOrderHeader.setNextMonthBillTotal(nsaCartOrderHeader.getNextMonthBillTotal());
            b360CartOrderHeader.setBarCodes(nsaCartOrderHeader.getBarCodes());
            b360CartOrderHeader.setSalesRepId(nsaCartOrderHeader.getSalesRepId());
            b360CartOrderHeader.setSaleType(nsaCartOrderHeader.getSaleType());
            b360CartOrderHeader.setCreditApplicationNum(nsaCartOrderHeader.getCreditApplicationNum());
            b360CartOrderHeader.setCreditCheckType(nsaCartOrderHeader.getCreditCheckType());
            b360CartOrderHeader.setState(nsaCartOrderHeader.getState());
            b360CartOrderHeader.setZipCode(nsaCartOrderHeader.getZipCode());
            b360CartOrderHeader.setOrderNumber(nsaCartOrderHeader.getOrderNumber());
            b360CartOrderHeader.setOutletId(nsaCartOrderHeader.getOutletId());
            b360CartOrderHeader.setRegisterNumber(nsaCartOrderHeader.getRegisterNumber());
            b360CartOrderHeader.setOrderChannelId(nsaCartOrderHeader.getOrderChannelId());
            b360CartOrderHeader.setOrderList(nsaCartOrderHeader.getOrderList());
            b360CartOrderHeader.setSalesRepUserIn(nsaCartOrderHeader.getSalesRepUserIn());
            b360CartOrderHeader.setResumeCartChannelID(nsaCartOrderHeader.getResumeCartChannelID());
            b360CartOrderHeader.setChannelValidated(nsaCartOrderHeader.isChannelValidated());
            b360CartOrderHeader.setManagerApproval(nsaCartOrderHeader.getManagerApproval());
            b360CartOrderHeader.setIsAssisted(nsaCartOrderHeader.isIsAssisted());
            b360CartOrderHeader.setEnableSplitShipment(nsaCartOrderHeader.isEnableSplitShipment());
            b360CartOrderHeader.setSplitShipmentIndicator(nsaCartOrderHeader.isSplitShipmentIndicator());
            b360CartOrderHeader.setBarcodeValidationIndicator(nsaCartOrderHeader.isBarcodeValidationIndicator());
            b360CartOrderHeader.setCartReadyForCheckout(nsaCartOrderHeader.isCartReadyForCheckout());
            b360CartOrderHeader.setIsSingleModConnectedDevice(nsaCartOrderHeader.isIsSingleModConnectedDevice());
            b360CartOrderHeader.setFiveGUpSellAccountLevel(nsaCartOrderHeader.isFiveGUpSellAccountLevel());
            b360CartOrderHeader.setEarliestShippingDate(nsaCartOrderHeader.getEarliestShippingDate());
            b360CartOrderHeader.setTotalDownPaymentAmt(nsaCartOrderHeader.getTotalDownPaymentAmt());
            b360CartOrderHeader.setTotalEdgeBuyOutAmount(nsaCartOrderHeader.getTotalEdgeBuyOutAmount());
            b360CartOrderHeader.setAvailableLotsForGrantee(nsaCartOrderHeader.isAvailableLotsForGrantee());
            b360CartOrderHeader.setCustomerOnTrialPlan(nsaCartOrderHeader.isCustomerOnTrialPlan());
            b360CartOrderHeader.setSaveCartEmailId(nsaCartOrderHeader.getSaveCartEmailId());
            b360CartOrderHeader.setExpressCheckout(nsaCartOrderHeader.isExpressCheckout());
        }
        
        // Set the converted header to the b360Cart
        b360Cart.setOrderDetails(b360CartOrderHeader);
    }
}

