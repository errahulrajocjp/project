// HIGHLIGHTED: Handle sqlPath for SQL tasks
if ((task.getTaskId().equals("BqTransform") || task.getTaskId().equals("BqSqlSensor")) && 
    task.hasSqlFile()) {
    
    String sqlFile = task.getSqlFileName();
    String sqlPath = task.getParameters().get("sqlPath");
    
    if (sqlPath != null && !sqlPath.trim().isEmpty()) {
        // Ensure path ends with a slash if needed
        if (!sqlPath.endsWith("/")) {
            sqlPath += "/";
        }
        
        // Get or create the nested path structure for Params→hook
        Map<String, Object> paramsMap = (Map<String, Object>) organizedParams.computeIfAbsent("Params", k -> new HashMap<>());
        Map<String, Object> hookMap = (Map<String, Object>) paramsMap.computeIfAbsent("hook", k -> new HashMap<>());
        
        // Update the sqlFile path
        hookMap.put("sqlFile", sqlPath + sqlFile);
    }
}
```

These changes work together to capture the path from the UI, store it in the database, and then use it when generating the View JSON API response to properly combine the path with the SQL filename.
