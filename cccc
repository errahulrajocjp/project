private void addParameterToStructure(Map<String, Object> structure, String level, String paramName, String paramValue) {
    // Skip empty values
    if (paramValue == null || paramValue.trim().isEmpty()) {
        return;
    }
    
    // If level is just "task", add to root
    if ("task".equals(level)) {
        structure.put(paramName, paramValue);
        return;
    }
    
    // Handle nested levels like "task.params.hook"
    if (level.startsWith("task.")) {
        String[] levels = level.substring(5).split("\\."); // Remove "task." prefix
        Map<String, Object> currentLevel = structure;
        
        // Navigate/create the nested structure
        for (int i = 0; i < levels.length; i++) {
            String levelName = levels[i];
            
            if (levelName.equals("params")) {
                levelName = "Params"; // Convert to capital P for DPF standard
            }
            
            // Create nested map for ALL levels, including the last one
            currentLevel.putIfAbsent(levelName, new HashMap<String, Object>());
            currentLevel = (Map<String, Object>) currentLevel.get(levelName);
        }
        
        // Special handling for certain parameters that need array conversion
        if (paramName.equals("object") && !paramValue.startsWith("[")) {
            // Convert single object to array format
            List<String> objectArray = new ArrayList<>();
            objectArray.add(paramValue);
            currentLevel.put(paramName, objectArray);
        } else {
            currentLevel.put(paramName, paramValue);
        }
    } else {
        // Fallback to root level if format is unexpected
        structure.put(paramName, paramValue);
    }
}
```

