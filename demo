@Override
public JsonNode generateDpfJson(String dagId) {
    // Fetch the DAG with tasks
    DagParameter dagParameter = dagParameterRepository.findById(dagId)
            .orElseThrow(() -> new ResourceNotFoundException("DAG not found with ID: " + dagId));
    
    ObjectMapper mapper = new ObjectMapper();
    ObjectNode rootNode = mapper.createObjectNode();
    
    // Add top-level DAG properties
    rootNode.put("Name", dagParameter.getDagName());
    rootNode.put("Type", dagParameter.getType());
    rootNode.put("Start_Date", "datetime.now() - timedelta(days=1)"); // Default, could be dynamic
    rootNode.put("Schedule_interval", dagParameter.getScheduleInterval() != null ? 
            dagParameter.getScheduleInterval() : "None");
    rootNode.put("max_active_runs", "1"); // Default value
    rootNode.put("catchup", dagParameter.getCatchup() != null ? 
            dagParameter.getCatchup() : "False");
    rootNode.put("Timezone", dagParameter.getTimezone() != null ? 
            dagParameter.getTimezone() : "EST");
    rootNode.put("Project_space", dagParameter.getProject().getProjectName());
    
    // Add run_config if needed
    if (dagParameter.getScheduleType() != null && dagParameter.getScheduleType().contains("weekDays")) {
        ObjectNode runConfig = mapper.createObjectNode();
        ArrayNode weekDays = mapper.createArrayNode();
        // Extract weekdays from scheduleType or parameters
        weekDays.add("Monday").add("Thursday").add("Friday").add("Tuesday"); // Example
        runConfig.set("weekDays", weekDays);
        rootNode.set("run_config", runConfig);
    }
    
    // Generate Steps array
    ArrayNode stepsArray = generateStepsArray(dagParameter.getTasks(), mapper);
    rootNode.set("Steps", stepsArray);
    
    return rootNode;
}

private ArrayNode generateStepsArray(List<TaskData> tasks, ObjectMapper mapper) {
    ArrayNode stepsArray = mapper.createArrayNode();
    
    // Add Start task if not present
    boolean hasStartTask = tasks.stream()
            .anyMatch(task -> "start".equalsIgnoreCase(task.getTaskName()));
    
    if (!hasStartTask) {
        ObjectNode startTask = mapper.createObjectNode();
        startTask.put("Name", "Start");
        startTask.put("Id", "start");
        startTask.put("Description", "This stage indicates the starting point of the task relationship in the dag");
        
        // Find the first task in the workflow
        if (!tasks.isEmpty()) {
            TaskData firstTask = tasks.stream()
                    .min(Comparator.comparing(TaskData::getSequenceOrder))
                    .orElse(tasks.get(0));
            startTask.put("OkTo", firstTask.getTaskName());
        }
        
        stepsArray.add(startTask);
    }
    
    // Process each task
    for (TaskData task : tasks) {
        ObjectNode taskNode = generateTaskNode(task, mapper);
        stepsArray.add(taskNode);
    }
    
    // Add End task if not present
    boolean hasEndTask = tasks.stream()
            .anyMatch(task -> "End".equalsIgnoreCase(task.getTaskName()));
    
    if (!hasEndTask) {
        ObjectNode endTask = mapper.createObjectNode();
        endTask.put("Name", "End");
        endTask.put("Id", "End");
        endTask.put("Description", "This stage indicates the ending point of the task relationship in the dag");
        endTask.put("OkTo", "End");
        stepsArray.add(endTask);
    }
    
    return stepsArray;
}

private ObjectNode generateTaskNode(TaskData task, ObjectMapper mapper) {
    ObjectNode taskNode = mapper.createObjectNode();
    
    // Basic task properties
    taskNode.put("Name", task.getTaskName());
    taskNode.put("Id", task.getTaskName()); // Assuming Id is same as taskName
    
    // Add Description if available
    String description = task.getParameters().get("Description");
    if (description != null) {
        taskNode.put("Description", description);
    }
    
    // Add Type if available
    String taskType = getTaskType(task.getTaskId());
    if (taskType != null) {
        taskNode.put("Type", taskType);
    }
    
    // Process parameters and organize by levels
    Map<String, Object> organizedParams = organizeParametersByLevel(task);
    
    // Add all organized parameters to the task node
    for (Map.Entry<String, Object> entry : organizedParams.entrySet()) {
        if (entry.getValue() instanceof Map) {
            taskNode.set(entry.getKey(), mapper.valueToTree(entry.getValue()));
        } else {
            taskNode.put(entry.getKey(), entry.getValue().toString());
        }
    }
    
    // Handle OkTo field
    String okTo = task.getParameters().get("okTo");
    if (okTo != null) {
        if (okTo.startsWith("[")) {
            try {
                JsonNode okToArray = mapper.readTree(okTo);
                taskNode.set("OkTo", okToArray);
            } catch (Exception e) {
                taskNode.put("OkTo", okTo);
            }
        } else {
            taskNode.put("OkTo", okTo);
        }
    }
    
    return taskNode;
}

private Map<String, Object> organizeParametersByLevel(TaskData task) {
    Map<String, Object> organizedParams = new HashMap<>();
    
    // Fetch task parameters definitions
    Task taskType = taskRepository.findById(task.getTaskId())
            .orElseThrow(() -> new ResourceNotFoundException("Task type not found: " + task.getTaskId()));
    
    List<TaskParam> taskParams = taskParamRepository.findByTask(taskType);
    
    // Process each parameter
    for (Map.Entry<String, String> param : task.getParameters().entrySet()) {
        String paramName = param.getKey();
        String paramValue = param.getValue();
        
        // Skip special parameters
        if ("okTo".equals(paramName) || paramName.startsWith("obs")) {
            continue;
        }
        
        // Find the parameter definition
        TaskParam taskParam = taskParams.stream()
                .filter(tp -> tp.getParamName().equals(paramName))
                .findFirst()
                .orElse(null);
        
        if (taskParam != null) {
            addParameterToStructure(organizedParams, taskParam.getParamLevel(), paramName, paramValue);
        } else {
            // If no definition found, add to root level
            organizedParams.put(paramName, paramValue);
        }
    }
    
    return organizedParams;
}

private void addParameterToStructure(Map<String, Object> structure, String level, String paramName, String paramValue) {
    if (level == null || "task".equals(level)) {
        // Root level parameter
        structure.put(paramName, paramValue);
        return;
    }
    
    String[] levels = level.split("\\.");
    Map<String, Object> currentLevel = structure;
    
    // Navigate/create the nested structure
    for (int i = 1; i < levels.length - 1; i++) { // Skip "task" prefix
        String levelName = levels[i];
        currentLevel.putIfAbsent(levelName, new HashMap<String, Object>());
        currentLevel = (Map<String, Object>) currentLevel.get(levelName);
    }
    
    // Add the parameter at the correct level
    currentLevel.put(paramName, paramValue);
}

private String getTaskType(String taskId) {
    // Map taskId to DPF task types
    Map<String, String> taskTypeMap = new HashMap<>();
    taskTypeMap.put("FILE_SENSOR", "GCS File sensor check");
    taskTypeMap.put("DAG_DEPENDENCY_CHECK", "dag dependency check");
    taskTypeMap.put("BqSqlSensor", "bigquery sqlsensor check");
    taskTypeMap.put("BqTransform", "run sql query from file");
    // Add more mappings as needed
    
    return taskTypeMap.getOrDefault(taskId, taskId);
}
