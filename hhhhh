        function showErrorDetails(errorName, description, example) {
            const modal = document.getElementById('errorModal');
            const title = document.getElementById('errorModalTitle');
            const desc = document.getElementById('errorModalDescription');
            const ex = document.getElementById('errorModalExample');
            const solution = document.getElementById('errorModalSolution');
            const warning = document.getElementById('errorModalWarning');

            title.textContent = errorName;
            desc.textContent = description;
            ex.textContent = example.replace(/\\n/g, '\n');

            // Generate solution and warning based on error type
            let solutionCode = generateErrorSolution(errorName);
            let warningText = generateErrorWarning(errorName);
            
            solution.textContent = solutionCode;
            warning.textContent = warningText;

            modal.style.display = 'flex';
            modal.style.animation = 'fadeIn 0.3s ease';
        }

