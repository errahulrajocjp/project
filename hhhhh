<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Java Exception Hierarchy - Tab Design</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            min-height: 100vh;
            padding: 20px;
        }

        .container {
            max-width: 1400px;
            margin: 0 auto;
            background: rgba(255, 255, 255, 0.95);
            border-radius: 20px;
            overflow: hidden;
            box-shadow: 0 25px 50px rgba(0, 0, 0, 0.15);
            backdrop-filter: blur(10px);
        }

        .header {
            background: linear-gradient(135deg, #2c3e50, #34495e);
            color: white;
            padding: 30px;
            text-align: center;
        }

        .title {
            font-size: 2.8em;
            font-weight: bold;
            margin-bottom: 10px;
            text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.3);
        }

        .subtitle {
            font-size: 1.3em;
            opacity: 0.9;
        }

        .tab-container {
            background: rgba(255, 255, 255, 0.9);
            border-bottom: 1px solid #ddd;
        }

        .tabs {
            display: flex;
            overflow-x: auto;
            scrollbar-width: none;
            -ms-overflow-style: none;
        }

        .tabs::-webkit-scrollbar {
            display: none;
        }

        .tab {
            flex-shrink: 0;
            padding: 20px 30px;
            cursor: pointer;
            background: rgba(108, 92, 231, 0.1);
            border-right: 1px solid rgba(108, 92, 231, 0.2);
            transition: all 0.3s ease;
            font-weight: 600;
            color: #6c5ce7;
            position: relative;
            overflow: hidden;
        }

        .tab::before {
            content: '';
            position: absolute;
            bottom: 0;
            left: 0;
            width: 100%;
            height: 4px;
            background: linear-gradient(90deg, #6c5ce7, #a29bfe);
            transform: translateX(-100%);
            transition: transform 0.3s ease;
        }

        .tab:hover {
            background: rgba(108, 92, 231, 0.15);
            transform: translateY(-2px);
        }

        .tab.active {
            background: linear-gradient(135deg, #6c5ce7, #a29bfe);
            color: white;
            box-shadow: 0 8px 25px rgba(108, 92, 231, 0.3);
        }

        .tab.active::before {
            transform: translateX(0);
        }

        .tab-content {
            display: none;
            padding: 40px;
            min-height: 600px;
            animation: fadeIn 0.5s ease;
        }

        .tab-content.active {
            display: block;
        }

        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(20px); }
            to { opacity: 1; transform: translateY(0); }
        }

        .tree {
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 20px;
        }

        .node {
            position: relative;
            margin: 8px;
            transition: all 0.3s ease;
        }

        .node-content {
            padding: 15px 25px;
            border-radius: 30px;
            font-weight: 600;
            text-align: center;
            min-width: 180px;
            cursor: pointer;
            border: 3px solid rgba(255, 255, 255, 0.3);
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.15);
            backdrop-filter: blur(5px);
            transition: all 0.3s ease;
            position: relative;
            overflow: hidden;
        }

        .node-content::before {
            content: '';
            position: absolute;
            top: 0;
            left: -100%;
            width: 100%;
            height: 100%;
            background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.3), transparent);
            transition: left 0.6s ease;
        }

        .node-content:hover::before {
            left: 100%;
        }

        .node-content:hover {
            transform: translateY(-5px) scale(1.05);
            box-shadow: 0 15px 40px rgba(0, 0, 0, 0.2);
        }

        /* Color Schemes */
        .object { background: linear-gradient(135deg, #6c5ce7, #a29bfe); color: white; }
        .throwable { background: linear-gradient(135deg, #fd79a8, #fdcb6e); color: white; }
        .exception { background: linear-gradient(135deg, #0984e3, #74b9ff); color: white; }
        .runtime-exception { background: linear-gradient(135deg, #e17055, #fab1a0); color: white; }
        .checked-exception { background: linear-gradient(135deg, #00b894, #55efc4); color: white; }
        .error { background: linear-gradient(135deg, #d63031, #ff7675); color: white; }

        .children {
            display: flex;
            flex-wrap: wrap;
            justify-content: center;
            gap: 15px;
            margin-top: 25px;
            max-width: 1200px;
        }

        /* Grid layouts for different tabs */
        .exception-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
            gap: 25px;
            max-width: 1200px;
            margin: 0 auto;
        }

        .category-section {
            background: rgba(255, 255, 255, 0.7);
            border-radius: 20px;
            padding: 25px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.1);
            backdrop-filter: blur(5px);
        }

        .category-title {
            font-size: 1.5em;
            font-weight: bold;
            margin-bottom: 20px;
            text-align: center;
            padding: 15px;
            border-radius: 15px;
            color: white;
        }

        .category-list {
            display: flex;
            flex-direction: column;
            gap: 12px;
        }

        .exception-item {
            padding: 12px 18px;
            background: rgba(255, 255, 255, 0.8);
            border-radius: 12px;
            border-left: 4px solid;
            transition: all 0.3s ease;
            cursor: pointer;
        }

        .exception-item:hover {
            transform: translateX(5px);
            box-shadow: 0 5px 15px rgba(0, 0, 0, 0.1);
        }

        .exception-item.runtime { border-left-color: #e17055; }
        .exception-item.checked { border-left-color: #00b894; }
        .exception-item.error { border-left-color: #d63031; }

        .hierarchy-overview {
            text-align: center;
            margin-bottom: 30px;
        }

        .two-column {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 40px;
            margin-top: 30px;
        }

        .collapsible .children {
            max-height: 1000px;
            overflow: hidden;
            transition: max-height 0.5s ease, opacity 0.3s ease;
            opacity: 1;
        }

        .collapsible.collapsed .children {
            max-height: 0;
            opacity: 0;
        }

        .toggle-icon {
            display: inline-block;
            margin-left: 8px;
            transition: transform 0.3s ease;
        }

        .collapsed .toggle-icon {
            transform: rotate(-90deg);
        }

        /* Info cards */
        .info-card {
            background: linear-gradient(135deg, rgba(108, 92, 231, 0.1), rgba(162, 155, 254, 0.1));
            border-radius: 15px;
            padding: 20px;
            margin: 20px 0;
            border-left: 5px solid #6c5ce7;
        }

        .info-card h3 {
            color: #6c5ce7;
            margin-bottom: 10px;
        }

        /* Connection lines for hierarchy */
        .connection-line {
            width: 2px;
            height: 30px;
            background: linear-gradient(to bottom, #ddd, #bbb);
            margin: 0 auto;
        }

        .horizontal-line {
            height: 2px;
            background: linear-gradient(to right, #ddd, #bbb, #ddd);
            margin: 10px 0;
        }

        /* Responsive design */
        @media (max-width: 768px) {
            .tabs {
                flex-direction: column;
            }
            
            .tab {
                border-right: none;
                border-bottom: 1px solid rgba(108, 92, 231, 0.2);
            }
            
            .two-column {
                grid-template-columns: 1fr;
                gap: 20px;
            }
            
            .exception-grid {
                grid-template-columns: 1fr;
            }
        }

        /* Modal Styles */
        .modal {
            position: fixed;
            z-index: 1000;
            left: 0;
            top: 0;
            width: 100%;
            height: 100%;
            background-color: rgba(0, 0, 0, 0.5);
            backdrop-filter: blur(5px);
            display: flex;
            justify-content: center;
            align-items: center;
        }

        .modal-content {
            background: linear-gradient(135deg, #ffffff, #f8f9fa);
            padding: 30px;
            border-radius: 20px;
            width: 90%;
            max-width: 700px;
            max-height: 80vh;
            overflow-y: auto;
            box-shadow: 0 25px 50px rgba(0, 0, 0, 0.3);
            position: relative;
            animation: modalSlideIn 0.3s ease;
        }

        @keyframes modalSlideIn {
            from {
                opacity: 0;
                transform: translateY(-50px) scale(0.9);
            }
            to {
                opacity: 1;
                transform: translateY(0) scale(1);
            }
        }

        .close {
            position: absolute;
            right: 20px;
            top: 15px;
            font-size: 28px;
            font-weight: bold;
            cursor: pointer;
            color: #aaa;
            transition: color 0.3s ease;
        }

        .close:hover {
            color: #e17055;
        }

        .detail-section {
            margin-bottom: 25px;
        }

        .detail-section h3 {
            color: #e17055;
            margin-bottom: 10px;
            font-size: 1.2em;
        }

        .detail-section pre {
            background: #2c3e50;
            color: #ecf0f1;
            padding: 15px;
            border-radius: 10px;
            font-family: 'Courier New', monospace;
            font-size: 0.9em;
            overflow-x: auto;
            border-left: 4px solid #e17055;
        }

        .detail-section p {
            font-size: 1.1em;
            line-height: 1.6;
            color: #2c3e50;
        }

    </style>
</head>
<body>
    <div class="container">
        <div class="header">
            <h1 class="title">Java Exception Hierarchy</h1>
            <p class="subtitle">Comprehensive guide to Java's exception and error handling system</p>
        </div>

        <div class="tab-container">
            <div class="tabs">
                <div class="tab active" onclick="showTab('overview')">📊 Complete Hierarchy</div>
                <div class="tab" onclick="showTab('runtime')">🔥 RuntimeException (Unchecked)</div>
                <div class="tab" onclick="showTab('checked')">✅ Checked Exceptions</div>
                <div class="tab" onclick="showTab('errors')">⚠️ Errors</div>
            </div>
        </div>

        <!-- Complete Hierarchy Tab -->
        <div id="overview" class="tab-content active">
            <div class="hierarchy-overview">
                <div class="info-card">
                    <h3>Java Exception Hierarchy Overview</h3>
                    <p>All exceptions and errors in Java inherit from <strong>Throwable</strong>. The hierarchy splits into two main branches: <strong>Exception</strong> (recoverable conditions) and <strong>Error</strong> (serious system problems).</p>
                </div>
            </div>

            <div class="tree">
                <div class="node">
                    <div class="node-content object">Object</div>
                </div>
                
                <div class="connection-line"></div>
                
                <div class="node">
                    <div class="node-content throwable">Throwable</div>
                </div>
                
                <div class="horizontal-line"></div>
                
                <div class="two-column">
                    <!-- Exception Branch -->
                    <div>
                        <div class="node">
                            <div class="node-content exception">Exception</div>
                        </div>
                        <div class="children">
                            <div class="node">
                                <div class="node-content runtime-exception">RuntimeException</div>
                            </div>
                            <div class="node">
                                <div class="node-content checked-exception">IOException</div>
                            </div>
                            <div class="node">
                                <div class="node-content checked-exception">SQLException</div>
                            </div>
                            <div class="node">
                                <div class="node-content checked-exception">ServletException</div>
                            </div>
                        </div>
                    </div>
                    
                    <!-- Error Branch -->
                    <div>
                        <div class="node">
                            <div class="node-content error">Error</div>
                        </div>
                        <div class="children">
                            <div class="node">
                                <div class="node-content error">LinkageError</div>
                            </div>
                            <div class="node">
                                <div class="node-content error">AssertionError</div>
                            </div>
                            <div class="node">
                                <div class="node-content error">VirtualMachineError</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- RuntimeException Tab -->
        <div id="runtime" class="tab-content">
            <div class="info-card">
                <h3>RuntimeException (Unchecked Exceptions)</h3>
                <p>These exceptions do <strong>not</strong> need to be declared in method signatures or caught. They typically indicate programming errors that could be prevented.</p>
            </div>

            <div class="tree">
                <!-- RuntimeException Root -->
                <div class="node collapsible">
                    <div class="node-content runtime-exception" onclick="toggleRuntimeChildren(this)">
                        RuntimeException <span class="toggle-icon">▼</span>
                    </div>
                    
                    <div class="children">
                        <!-- Direct children of RuntimeException -->
                        <div class="node">
                            <div class="node-content runtime-exception" onclick="showExceptionDetails('ArithmeticException', 'Division by zero or similar arithmetic errors', 'int result = 10 / 0; // throws ArithmeticException')">
                                ArithmeticException
                            </div>
                        </div>
                        
                        <div class="node">
                            <div class="node-content runtime-exception" onclick="showExceptionDetails('NullPointerException', 'Accessing methods/fields on null reference', 'String contractId = null;\\ncontractId.split(\"-\"); // throws NullPointerException')">
                                NullPointerException
                            </div>
                        </div>
                        
                        <div class="node collapsible">
                            <div class="node-content runtime-exception" onclick="toggleCollapse(this)">
                                IndexOutOfBoundsException <span class="toggle-icon">▼</span>
                            </div>
                            <div class="children">
                                <div class="node">
                                    <div class="node-content runtime-exception" onclick="showExceptionDetails('ArrayIndexOutOfBoundsException', 'Array index is negative or >= array length', 'String[] parts = {\"CNT\", \"2024\", \"0001\"};\\nString invalid = parts[5]; // throws ArrayIndexOutOfBoundsException')">
                                        ArrayIndexOutOfBoundsException
                                    </div>
                                </div>
                                <div class="node">
                                    <div class="node-content runtime-exception" onclick="showExceptionDetails('StringIndexOutOfBoundsException', 'String index is negative or >= string length', 'String contractId = \"CNT-2024\";\\nchar invalid = contractId.charAt(20); // throws StringIndexOutOfBoundsException')">
                                        StringIndexOutOfBoundsException
                                    </div>
                                </div>
                            </div>
                        </div>
                        
                        <div class="node collapsible">
                            <div class="node-content runtime-exception" onclick="toggleCollapse(this)">
                                IllegalArgumentException <span class="toggle-icon">▼</span>
                            </div>
                            <div class="children">
                                <div class="node">
                                    <div class="node-content runtime-exception" onclick="showExceptionDetails('NumberFormatException', 'String cannot be parsed to numeric value', 'int year = Integer.parseInt(\"ABCD\"); // throws NumberFormatException')">
                                        NumberFormatException
                                    </div>
                                </div>
                            </div>
                        </div>
                        
                        <div class="node">
                            <div class="node-content runtime-exception" onclick="showExceptionDetails('ClassCastException', 'Invalid type casting operation', 'Object obj = \"Hello\";\\nInteger num = (Integer) obj; // throws ClassCastException')">
                                ClassCastException
                            </div>
                        </div>
                        
                        <div class="node">
                            <div class="node-content runtime-exception" onclick="showExceptionDetails('IllegalStateException', 'Method called at inappropriate time', 'Iterator<String> iter = list.iterator();\\nlist.add(\"new item\");\\niter.next(); // may throw IllegalStateException')">
                                IllegalStateException
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Exception Details Modal -->
            <div id="exceptionModal" class="modal" style="display: none;">
                <div class="modal-content">
                    <span class="close" onclick="closeModal()">&times;</span>
                    <h2 id="modalTitle">Exception Details</h2>
                    <div class="modal-body">
                        <div class="detail-section">
                            <h3>Description:</h3>
                            <p id="modalDescription"></p>
                        </div>
                        <div class="detail-section">
                            <h3>Contract Processing Example:</h3>
                            <pre id="modalExample"></pre>
                        </div>
                        <div class="detail-section">
                            <h3>How to Handle:</h3>
                            <pre id="modalSolution"></pre>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Checked Exceptions Tab -->
        <div id="checked" class="tab-content">
            <div class="info-card">
                <h3>Checked Exceptions</h3>
                <p>These exceptions <strong>must</strong> be either caught or declared in the method signature. They represent recoverable conditions that the application should handle.</p>
            </div>

            <div class="exception-grid">
                <div class="category-section">
                    <div class="category-title checked-exception">I/O Related</div>
                    <div class="category-list">
                        <div class="exception-item checked">
                            <strong>IOException</strong><br>
                            <small>General I/O operations failure</small>
                        </div>
                        <div class="exception-item checked">
                            <strong>├─ FileNotFoundException</strong><br>
                            <small>File doesn't exist or can't be accessed</small>
                        </div>
                        <div class="exception-item checked">
                            <strong>├─ EOFException</strong><br>
                            <small>End of file reached unexpectedly</small>
                        </div>
                        <div class="exception-item checked">
                            <strong>└─ InterruptedIOException</strong><br>
                            <small>I/O operation interrupted</small>
                        </div>
                    </div>
                </div>

                <div class="category-section">
                    <div class="category-title checked-exception">Database & Web</div>
                    <div class="category-list">
                        <div class="exception-item checked">
                            <strong>SQLException</strong><br>
                            <small>Database access errors</small>
                        </div>
                        <div class="exception-item checked">
                            <strong>ServletException</strong><br>
                            <small>Servlet-related errors</small>
                        </div>
                        <div class="exception-item checked">
                            <strong>ClassNotFoundException</strong><br>
                            <small>Class not found during runtime loading</small>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Errors Tab -->
        <div id="errors" class="tab-content">
            <div class="info-card">
                <h3>Errors</h3>
                <p>Errors represent serious problems that applications should <strong>not</strong> try to catch. They indicate system-level issues or resource exhaustion.</p>
            </div>

            <div class="tree">
                <!-- Error Root -->
                <div class="node">
                    <div class="node-content error">Error</div>
                    
                    <div class="children">
                        <!-- VirtualMachineError Branch -->
                        <div class="node collapsible">
                            <div class="node-content error" onclick="toggleCollapse(this)">
                                VirtualMachineError <span class="toggle-icon">▼</span>
                            </div>
                            <div class="children">
                                <div class="node">
                                    <div class="node-content error" onclick="showErrorDetails('OutOfMemoryError', 'JVM runs out of heap memory', 'List<ContractConfig> contracts = new ArrayList<>();\\nfor (int i = 0; i < 10_000_000; i++) {\\n    contracts.add(new ContractConfig()); // Eventually OutOfMemoryError\\n}')">
                                        OutOfMemoryError
                                    </div>
                                </div>
                                <div class="node">
                                    <div class="node-content error" onclick="showErrorDetails('StackOverflowError', 'Call stack exceeds limit due to infinite recursion', 'public void validateContract(ContractConfig contract) {\\n    validateContract(contract); // Infinite recursion\\n    // Eventually StackOverflowError\\n}')">
                                        StackOverflowError
                                    </div>
                                </div>
                            </div>
                        </div>
                        
                        <!-- LinkageError Branch -->
                        <div class="node collapsible">
                            <div class="node-content error" onclick="toggleCollapse(this)">
                                LinkageError <span class="toggle-icon">▼</span>
                            </div>
                            <div class="children">
                                <div class="node">
                                    <div class="node-content error" onclick="showErrorDetails('VerifyError', 'Bytecode verification failure during class loading', '// Occurs when JVM detects corrupted bytecode\\n// Usually caused by:  \\n// 1. Corrupted .class files\\n// 2. Version mismatch between compiled and runtime\\n// 3. Modified bytecode that violates JVM rules')">
                                        VerifyError
                                    </div>
                                </div>
                            </div>
                        </div>
                        
                        <!-- AssertionError -->
                        <div class="node">
                            <div class="node-content error" onclick="showErrorDetails('AssertionError', 'Assertion statement fails', 'public void processContract(ContractConfig contract) {\\n    assert contract != null : \"Contract cannot be null\";\\n    // If assertions enabled and contract is null:\\n    // throws AssertionError\\n}')">
                                AssertionError
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Error Details Modal -->
            <div id="errorModal" class="modal" style="display: none;">
                <div class="modal-content">
                    <span class="close" onclick="closeErrorModal()">&times;</span>
                    <h2 id="errorModalTitle">Error Details</h2>
                    <div class="modal-body">
                        <div class="detail-section">
                            <h3>Description:</h3>
                            <p id="errorModalDescription"></p>
                        </div>
                        <div class="detail-section">
                            <h3>Contract Processing Example:</h3>
                            <pre id="errorModalExample"></pre>
                        </div>
                        <div class="detail-section">
                            <h3>Prevention & Handling:</h3>
                            <pre id="errorModalSolution"></pre>
                        </div>
                        <div class="detail-section">
                            <h3>⚠️ Important Note:</h3>
                            <p id="errorModalWarning"></p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script>
        function showTab(tabName) {
            // Hide all tab contents
            const contents = document.querySelectorAll('.tab-content');
            contents.forEach(content => content.classList.remove('active'));
            
            // Remove active class from all tabs
            const tabs = document.querySelectorAll('.tab');
            tabs.forEach(tab => tab.classList.remove('active'));
            
            // Show selected tab content
            document.getElementById(tabName).classList.add('active');
            
            // Mark selected tab as active
            event.target.classList.add('active');
        }

        function toggleCollapse(element) {
            const node = element.parentElement;
            node.classList.toggle('collapsed');
            
            // Add ripple effect
            const ripple = document.createElement('div');
            ripple.style.position = 'absolute';
            ripple.style.width = '10px';
            ripple.style.height = '10px';
            ripple.style.background = 'rgba(255, 255, 255, 0.6)';
            ripple.style.borderRadius = '50%';
            ripple.style.transform = 'scale(0)';
            ripple.style.animation = 'ripple 0.6s ease-out';
            ripple.style.left = '50%';
            ripple.style.top = '50%';
            ripple.style.marginLeft = '-5px';
            ripple.style.marginTop = '-5px';
            
            element.style.position = 'relative';
            element.appendChild(ripple);
            
            setTimeout(() => ripple.remove(), 600);
        }

        function toggleRuntimeChildren(element) {
            toggleCollapse(element);
        }

        function showExceptionDetails(exceptionName, description, example) {
            const modal = document.getElementById('exceptionModal');
            const title = document.getElementById('modalTitle');
            const desc = document.getElementById('modalDescription');
            const ex = document.getElementById('modalExample');
            const solution = document.getElementById('modalSolution');

            title.textContent = exceptionName;
            desc.textContent = description;
            ex.textContent = example.replace(/\\n/g, '\n');

            // Generate solution based on exception type
            let solutionCode = generateSolution(exceptionName, example);
            solution.textContent = solutionCode;

            modal.style.display = 'flex';
            
            // Add fade-in animation
            modal.style.animation = 'fadeIn 0.3s ease';
        }

        function generateSolution(exceptionName, example) {
            const solutions = {
                'NullPointerException': `// Solution: Check for null before using
if (contractId != null) {
    String[] parts = contractId.split("-");
    // Process parts safely
} else {
    System.out.println("Contract ID is null");
}`,
                'NumberFormatException': `// Solution: Use try-catch for parsing
try {
    int year = Integer.parseInt(yearString);
    // Use parsed year
} catch (NumberFormatException e) {
    System.out.println("Invalid year format: " + yearString);
    // Handle error appropriately
}`,
                'ArrayIndexOutOfBoundsException': `// Solution: Check array bounds
