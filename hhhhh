        function closeErrorModal() {
            const modal = document.getElementById('errorModal');
            modal.style.animation = 'fadeOut 0.3s ease';
            setTimeout(() => {
                modal.style.display = 'none';
            }, 300);
        }

        function closeModal() {
            const modal = document.getElementById('exceptionModal');
            modal.style.animation = 'fadeOut 0.3s ease';
            setTimeout(() => {
                modal.style.display = 'none';
            }, 300);
        }

        // Add click effects to exception items
        document.addEventListener('DOMContentLoaded', function() {
            const items = document.querySelectorAll('.exception-item');
            items.forEach(item => {
                item.addEventListener('click', function() {
                    this.style.transform = 'scale(0.98)';
                    setTimeout(() => {
                        this.style.transform = 'translateX(5px)';
                    }, 150);
                });
            });

            // Initialize collapsed state for RuntimeException children
            const runtimeNode = document.querySelector('#runtime .collapsible');
            if (runtimeNode) {
                runtimeNode.classList.add('collapsed');
            }

            // Initialize collapsed state for Error children (VirtualMachineError and LinkageError)
            const errorNodes = document.querySelectorAll('#errors .collapsible');
            errorNodes.forEach(node => {
                node.classList.add('collapsed');
            });
        });

        // Add fade animations
        const style = document.createElement('style');
        style.textContent = `
            @keyframes ripple {
                to {
                    transform: scale(4);
                    opacity: 0;
                }
            }
            @keyframes fadeIn {
                from { opacity: 0; }
                to { opacity: 1; }
            }
            @keyframes fadeOut {
                from { opacity: 1; }
                to { opacity: 0; }
            }
        `;
        document.head.appendChild(style);

        // Close modal when clicking outside
        window.onclick = function(event) {
            const exceptionModal = document.getElementById('exceptionModal');
            const errorModal = document.getElementById('errorModal');
            
            if (event.target === exceptionModal) {
                closeModal();
            }
            if (event.target === errorModal) {
                closeErrorModal();
            }
        }
    </script>
