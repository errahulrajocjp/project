        function generateErrorWarning(errorName) {
            const warnings = {
                'OutOfMemoryError': 'Errors should NOT be caught in normal application code. OutOfMemoryError indicates a serious resource problem. Focus on prevention through proper memory management, processing data in chunks, and appropriate JVM heap sizing.',
                
                'StackOverflowError': 'DO NOT catch StackOverflowError! It indicates infinite recursion or excessively deep method calls. Fix the underlying recursive logic or convert to iterative approach. Catching this error can lead to unpredictable behavior.',
                
                'VerifyError': 'VerifyError occurs during class loading and indicates corrupted bytecode or version incompatibilities. This is typically a deployment/build issue, not a runtime programming error. Ensure proper compilation and compatible Java versions.',
                
                'AssertionError': 'AssertionError should not be caught in production code. Assertions are debugging tools that can be disabled. Use proper exception handling for business logic validation instead of relying on assertions.'
