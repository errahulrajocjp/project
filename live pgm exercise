import java.text.SimpleDateFormat;
import java.util.Date;

class Exercise1Solution {
    
    /**
     * Contract ID validation WITHOUT exception handling
     * Expected format: CNT-YYYY-NNNN (e.g., CNT-2024-0001)
     */
    public static boolean validateContractId(String contractId) {
        System.out.println("    Validating contract ID: " + contractId);
        
        // This will throw NullPointerException if contractId is null
        String[] parts = contractId.split("-");
        
        if (parts.length != 3) {
            return false;
        }
        
        String prefix = parts[0];
        String year = parts[1];
        String sequence = parts[2];
        
        // Check prefix
        if (!"CNT".equals(prefix)) {
            return false;
        }
        
        // Check year (4 digits) - NumberFormatException possible
        if (year.length() != 4) {
            return false;
        }
        int yearValue = Integer.parseInt(year);  // Can throw NumberFormatException
        
        // Check sequence (4 digits) - NumberFormatException possible  
        if (sequence.length() != 4) {
            return false;
        }
        int sequenceValue = Integer.parseInt(sequence);  // Can throw NumberFormatException
        
        return true;
    }
    
    /**
     * Date parsing WITHOUT exception handling
     * Expected format: yyyy-MM-dd
     */
    public static Date parseEffectiveDate(String dateString) {
        System.out.println("    Parsing date: " + dateString);
        
        SimpleDateFormat sdf = new SimpleDateFormat("yyyy-MM-dd");
        try {
            return sdf.parse(dateString);  // Can throw ParseException
        } catch (Exception e) {
            // Even though we're "not handling exceptions", parse() forces us to catch
            throw new RuntimeException(e);  // Convert to unchecked exception
        }
    }
    
    public static void main(String[] args) {
        System.out.println("=".repeat(60));
        System.out.println("EXERCISE 1: OBSERVING EXCEPTIONS IN CONTRACT PROCESSING");
        System.out.println("=".repeat(60));
        
