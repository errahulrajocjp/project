import java.io.*;
import java.text.ParseException;
import java.text.SimpleDateFormat;
import java.util.*;
import java.util.concurrent.ConcurrentHashMap;

class Exercise4Solution {
    
    // In-memory contract store (thread-safe)
    private static Map<String, ContractConfig> contractStore = new ConcurrentHashMap<>();
    
    /**
     * Main processing method - comprehensive contract management
     */
    public static ProcessingReport processContractsFromFile(String filePath) {
        ProcessingReport report = new ProcessingReport();
        report.startProcessing();
        
        try {
            // Validate file exists and is readable
            File file = new File(filePath);
            if (!file.exists()) {
                throw new FileNotFoundException("Contract file does not exist: " + filePath);
            }
            
            if (!file.canRead()) {
                throw new IOException("Cannot read contract file: " + filePath);
            }
            
            System.out.println("📁 Processing contracts from: " + filePath);
            System.out.println("📊 File size: " + file.length() + " bytes");
            
            // Process file line by line
            try (BufferedReader reader = new BufferedReader(new FileReader(file))) {
                String line;
                int lineNumber = 0;
                
                while ((line = reader.readLine()) != null) {
                    lineNumber++;
                    report.incrementTotalProcessed();
                    
                    try {
                        // Skip empty lines and comments
                        if (line.trim().isEmpty() || line.trim().startsWith("#")) {
                            report.incrementSkipped();
                            continue;
                        }
                        
                        System.out.println("\n🔄 Line " + lineNumber + ": " + line);
                        
                        // Parse contract data
                        ContractConfig contract = parseContractFromLine(line, lineNumber);
                        
                        // Validate business rules
                        validateBusinessRules(contract);
                        
                        // Check for duplicates
                        checkForDuplicates(contract);
                        
                        // Save to store
                        saveContract(contract);
                        
                        report.addSuccess(contract);
                        System.out.println("  ✅ Contract processed successfully: " + contract.getContractId());
                        
                    } catch (DataParseException e) {
                        report.addParseError(lineNumber, e.getMessage());
                        System.out.println("  ❌ Parse error: " + e.getMessage());
                    } catch (BusinessRuleException e) {
                        report.addBusinessRuleError(lineNumber, e.getMessage());
                        System.out.println("  ⚠️ Business rule violation: " + e.getMessage());
                    } catch (DuplicateContractException e) {
                        report.addDuplicateError(lineNumber, e.getMessage());
                        System.out.println("  🔄 Duplicate contract: " + e.getMessage());
                    } catch (Exception e) {
                        report.addUnexpectedError(lineNumber, e.getMessage());
                        System.out.println("  💥 Unexpected error: " + e.getMessage());
                        e.printStackTrace(); // For debugging
                    }
                }
            }
            
        } catch (FileNotFoundException e) {
            report.addSystemError("File not found: " + e.getMessage());
            System.err.println("📂 File Error: " + e.getMessage());
        } catch (IOException e) {
            report.addSystemError("IO error: " + e.getMessage());
            System.err.println("💾 IO Error: " + e.getMessage());
        } catch (SecurityException e) {
            report.addSystemError("Security error: " + e.getMessage());
            System.err.println("🔒 Security Error: " + e.getMessage());
        } catch (Exception e) {
            report.addSystemError("Unexpected system error: " + e.getMessage());
            System.err.println("💥 System Error: " + e.getMessage());
            e.printStackTrace();
        } finally {
            report.endProcessing();
        }
        
        return report;
    }
    
    /**
     * Parse contract from a single line
     */
    private static ContractConfig parseContractFromLine(String line, int lineNumber) throws DataParseException {
        try {
            String[] parts = line.split(",");
            
            if (parts.length < 4) {
                throw new DataParseException("Invalid format - expected 4 fields, got " + parts.length);
            }
            
            String contractId = parts[0].trim();
            String effectiveDate = parts[1].trim();
            String expiryDate = parts[2].trim();
            String status = parts[3].trim();
            
            // Validate required fields
            if (contractId.isEmpty()) {
                throw new DataParseException("Contract ID cannot be empty");
            }
            
            if (effectiveDate.isEmpty()) {
                throw new DataParseException("Effective date cannot be empty");
            }
            
            if (status.isEmpty()) {
                throw new DataParseException("Status cannot be empty");
            }
            
            // Validate contract ID format
            if (!contractId.matches("CNT-\\d{4}-\\d{4}")) {
                throw new DataParseException("Invalid contract ID format: " + contractId);
            }
            
            // Parse dates
            SimpleDateFormat sdf = new SimpleDateFormat("yyyy-MM-dd");
            sdf.setLenient(false);
            
            Date parsedEffectiveDate = sdf.parse(effectiveDate);
            
            Date parsedExpiryDate = null;
            if (!expiryDate.isEmpty()) {
                parsedExpiryDate = sdf.parse(expiryDate);
            }
            
            // Validate status
            if (!Arrays.asList("ACTIVE", "INACTIVE", "PENDING", "EXPIRED").contains(status.toUpperCase())) {
                throw new DataParseException("Invalid status: " + status);
            }
            
            // Create contract
            ContractConfig contract = new ContractConfig();
            contract.setContractId(contractId);
            contract.setContractEffectiveDate(parsedEffectiveDate);
            contract.setContractExpiryDate(parsedExpiryDate);
            contract.setStatus(status.toUpperCase());
            
            return contract;
            
        } catch (ParseException e) {
            throw new DataParseException("Date parsing error: " + e.getMessage());
        } catch (ArrayIndexOutOfBoundsException e) {
            throw new DataParseException("Data format error: missing fields");
        }
    }
    
    /**
     * Comprehensive business rule validation
     */
    public static void validateBusinessRules(ContractConfig contract) throws BusinessRuleException {
        Date now = new Date();
        Date effective = contract.getContractEffectiveDate();
        Date expiry = contract.getContractExpiryDate();
        
        // Rule 1: Effective date validation
        Calendar cal = Calendar.getInstance();
        cal.add(Calendar.YEAR, -5);
        Date fiveYearsAgo = cal.getTime();
        
        if (effective.before(fiveYearsAgo)) {
            throw new BusinessRuleException("Contract effective date cannot be more than 5 years in the past");
        }
        
        cal.setTime(now);
        cal.add(Calendar.YEAR, 2);
        Date twoYearsFromNow = cal.getTime();
        
        if (effective.after(twoYearsFromNow)) {
            throw new BusinessRuleException("Contract effective date cannot be more than 2 years in the future");
        }
        
        // Rule 2: Expiry date validation
        if (expiry != null) {
            if (expiry.before(effective)) {
                throw new BusinessRuleException("Contract expiry date cannot be before effective date");
            }
            
            // Maximum contract duration: 15 years
            cal.setTime(effective);
            cal.add(Calendar.YEAR, 15);
            Date maxExpiry = cal.getTime();
            
            if (expiry.after(maxExpiry)) {
                throw new BusinessRuleException("Contract duration cannot exceed 15 years");
            }
            
            // Minimum contract duration: 30 days
            cal.setTime(effective);
            cal.add(Calendar.DAY_OF_MONTH, 30);
            Date minExpiry = cal.getTime();
            
            if (expiry.before(minExpiry)) {
                throw new BusinessRuleException("Contract duration must be at least 30 days");
            }
        }
        
        // Rule 3: Status validation based on dates
        if ("EXPIRED".equals(contract.getStatus()) && expiry != null && expiry.after(now)) {
            throw new BusinessRuleException("Contract cannot be marked as EXPIRED if expiry date is in the future");
        }
        
        if ("ACTIVE".equals(contract.getStatus()) && effective.after(now)) {
            throw new BusinessRuleException("Contract cannot be ACTIVE if effective date is in the future");
        }
        
        // Rule 4: Contract ID year should match effective date year
        String contractYear = contract.getContractId().substring(4, 8);
        cal.setTime(effective);
        int effectiveYear = cal.get(Calendar.YEAR);
        
        if (!contractYear.equals(String.valueOf(effectiveYear))) {
            throw new BusinessRuleException("Contract ID year (" + contractYear + 
                ") should match effective date year (" + effectiveYear + ")");
        }
    }
    
    /**
     * Check for duplicate contracts
     */
    private static void checkForDuplicates(ContractConfig contract) throws DuplicateContractException {
        if (contractStore.containsKey(contract.getContractId())) {
            ContractConfig existing = contractStore.get(contract.getContractId());
            throw new DuplicateContractException("Contract ID already exists: " + contract.getContractId() + 
                " (existing status: " + existing.getStatus() + ")");
        }
    }
    
    /**
     * Save contract to store with validation
     */
    public static void saveContract(ContractConfig contract) throws IllegalArgumentException {
        if (contract == null) {
            throw new IllegalArgumentException("Contract cannot be null");
        }
        
        if (contract.getContractId() == null || contract.getContractId().trim().isEmpty()) {
            throw new IllegalArgumentException("Contract ID is required");
        }
        
        contractStore.put(contract.getContractId(), contract);
    }
    
    /**
     * Custom exception classes
     */
    static class BusinessRuleException extends Exception {
        public BusinessRuleException(String message) {
            super(message);
        }
    }
    
    static class DuplicateContractException extends Exception {
        public DuplicateContractException(String message) {
            super(message);
        }
    }
    
    static class DataParseException extends Exception {
        public DataParseException(String message) {
            super(message);
        }
    }
    
    /**
     * Comprehensive processing report
     */
    static class ProcessingReport {
        private long startTime;
        private long endTime;
        private int totalProcessed = 0;
        private int skipped = 0;
        private List<ContractConfig> successfulContracts = new ArrayList<>();
        private List<String> parseErrors = new ArrayList<>();
        private List<String> businessRuleErrors = new ArrayList<>();
        private List<String> duplicateErrors = new ArrayList<>();
        private List<String> unexpectedErrors = new ArrayList<>();
        private List<String> systemErrors = new ArrayList<>();
        
        public void startProcessing() {
            this.startTime = System.currentTimeMillis();
        }
        
        public void endProcessing() {
            this.endTime = System.currentTimeMillis();
        }
        
        public void incrementTotalProcessed() { totalProcessed++; }
        public void incrementSkipped() { skipped++; }
        
        public void addSuccess(ContractConfig contract) { successfulContracts.add(contract); }
        public void addParseError(int line, String error) { parseErrors.add("Line " + line + ": " + error); }
        public void addBusinessRuleError(int line, String error) { businessRuleErrors.add("Line " + line + ": " + error); }
        public void addDuplicateError(int line, String error) { duplicateErrors.add("Line " + line + ": " + error); }
        public void addUnexpectedError(int line, String error) { unexpectedErrors.add("Line " + line + ": " + error); }
        public void addSystemError(String error) { systemErrors.add(error); }
        
        public void generateReport() {
            System.out.println("\n" + "=".repeat(70));
            System.out.println("📊 CONTRACT PROCESSING REPORT");
            System.out.println("=".repeat(70));
            
            // Summary statistics
            System.out.println("⏱️  Processing time: " + (endTime - startTime) + " ms");
            System.out.println("📈 Total lines processed: " + totalProcessed);
            System.out.println("⏭️  Lines skipped: " + skipped);
            System.out.println("✅ Successful contracts: " + successfulContracts.size());
            
            int totalErrors = parseErrors.size() + businessRuleErrors.size() + 
                            duplicateErrors.size() + unexpectedErrors.size() + systemErrors.size();
            System.out.println("❌ Total errors: " + totalErrors);
            
            if (totalProcessed > 0) {
                double successRate = (double) successfulContracts.size() / totalProcessed * 100;
                System.out.println("📊 Success rate: " + String.format("%.1f%%", successRate));
            }
            
            // Error breakdown
            if (totalErrors > 0) {
                System.out.println("\n📋 ERROR BREAKDOWN:");
                if (!parseErrors.isEmpty()) {
                    System.out.println("  🔧 Parse errors (" + parseErrors.size() + "):");
                    parseErrors.forEach(error -> System.out.println("    • " + error));
                }
                
                if (!businessRuleErrors.isEmpty()) {
                    System.out.println("  ⚖️ Business rule errors (" + businessRuleErrors.size() + "):");
                    businessRuleErrors.forEach(error -> System.out.println("    • " + error));
                }
                
                if (!duplicateErrors.isEmpty()) {
                    System.out.println("  🔄 Duplicate errors (" + duplicateErrors.size() + "):");
                    duplicateErrors.forEach(error -> System.out.println("    • " + error));
                }
                
                if (!unexpectedErrors.isEmpty()) {
                    System.out.println("  💥 Unexpected errors (" + unexpectedErrors.size() + "):");
                    unexpectedErrors.forEach(error -> System.out.println("    • " + error));
                }
                
                if (!systemErrors.isEmpty()) {
                    System.out.println("  🖥️ System errors (" + systemErrors.size() + "):");
                    systemErrors.forEach(error -> System.out.println("    • " + error));
                }
            }
            
            // Successful contracts
            if (!successfulContracts.isEmpty()) {
                System.out.println("\n✅ SUCCESSFUL CONTRACTS:");
                for (ContractConfig contract : successfulContracts) {
                    System.out.println("  📄 " + contract.getContractId() + " - " + contract.getStatus() + 
                        " (Effective: " + contract.getContractEffectiveDate() + ")");
                }
            }
            
            System.out.println("=".repeat(70));
        }
    }
    
