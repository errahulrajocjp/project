import java.io.*;
import java.text.ParseException;
import java.text.SimpleDateFormat;
import java.util.*;

class Exercise3Solution {
    
    /**
     * Process contracts from file with comprehensive exception handling
     */
    public static ProcessingResult processContractFile(String filePath) {
        ProcessingResult result = new ProcessingResult();
        BufferedReader reader = null;
        int lineNumber = 0;
        
        try {
            System.out.println("Opening file: " + filePath);
            reader = new BufferedReader(new FileReader(filePath));
            String line;
            
            while ((line = reader.readLine()) != null) {
                lineNumber++;
                
                try {
                    System.out.println("\nProcessing line " + lineNumber + ": " + line);
                    
                    // Skip empty lines
                    if (line.trim().isEmpty()) {
                        System.out.println("  Skipping empty line");
                        continue;
                    }
                    
                    // Parse contract data
                    String[] parts = line.split(",");
                    if (parts.length < 4) {
                        throw new IllegalArgumentException("Invalid data format - expected 4 fields, got " + parts.length);
                    }
                    
                    String contractId = parts[0].trim();
                    String effectiveDate = parts[1].trim();
                    String expiryDate = parts[2].trim();
                    String status = parts[3].trim();
                    
                    // Create contract
                    ContractConfig contract = createAndValidateContract(contractId, effectiveDate, expiryDate, status);
                    
                    // Validate business rules
                    validateBusinessRules(contract);
                    
                    result.addSuccess(contract);
                    System.out.println("  ✓ Successfully processed contract: " + contractId);
                    
                } catch (IllegalArgumentException e) {
                    String error = "Line " + lineNumber + " - Data validation error: " + e.getMessage();
                    result.addError(error);
                    System.out.println("  ✗ " + error);
                } catch (ParseException e) {
                    String error = "Line " + lineNumber + " - Date parsing error: " + e.getMessage();
                    result.addError(error);
                    System.out.println("  ✗ " + error);
                } catch (BusinessRuleException e) {
                    String error = "Line " + lineNumber + " - Business rule violation: " + e.getMessage();
                    result.addError(error);
                    System.out.println("  ✗ " + error);
                } catch (Exception e) {
                    String error = "Line " + lineNumber + " - Unexpected error: " + e.getMessage();
                    result.addError(error);
                    System.out.println("  ✗ " + error);
                }
            }
            
        } catch (FileNotFoundException e) {
            String error = "File not found: " + filePath;
            result.addError(error);
            System.err.println("✗ " + error);
        } catch (IOException e) {
            String error = "IO error reading file: " + e.getMessage();
            result.addError(error);
            System.err.println("✗ " + error);
        } catch (Exception e) {
            String error = "Unexpected error: " + e.getMessage();
            result.addError(error);
            System.err.println("✗ " + error);
        } finally {
            // Always close the file reader
            if (reader != null) {
                try {
                    reader.close();
                    System.out.println("File closed successfully");
                } catch (IOException e) {
                    System.err.println("Error closing file: " + e.getMessage());
                }
            }
        }
        
        return result;
    }
    
    /**
     * Create and validate contract
     */
    private static ContractConfig createAndValidateContract(String contractId, String effectiveDate, 
                                                           String expiryDate, String status) 
                                                           throws IllegalArgumentException, ParseException {
        
        // Validate contract ID
        if (contractId == null || contractId.isEmpty()) {
            throw new IllegalArgumentException("Contract ID cannot be null or empty");
        }
        
        if (!contractId.matches("CNT-\\d{4}-\\d{4}")) {
            throw new IllegalArgumentException("Invalid contract ID format: " + contractId);
        }
        
        // Parse dates
        SimpleDateFormat sdf = new SimpleDateFormat("yyyy-MM-dd");
        sdf.setLenient(false);
        
        Date parsedEffectiveDate = null;
        if (effectiveDate != null && !effectiveDate.isEmpty()) {
            parsedEffectiveDate = sdf.parse(effectiveDate);
        } else {
            throw new IllegalArgumentException("Effective date is required");
        }
        
        Date parsedExpiryDate = null;
        if (expiryDate != null && !expiryDate.isEmpty()) {
            parsedExpiryDate = sdf.parse(expiryDate);
        }
        
        // Validate status
        if (!Arrays.asList("ACTIVE", "INACTIVE", "PENDING", "EXPIRED").contains(status)) {
            throw new IllegalArgumentException("Invalid status: " + status);
        }
        
        // Create contract
        ContractConfig contract = new ContractConfig();
        contract.setContractId(contractId);
        contract.setContractEffectiveDate(parsedEffectiveDate);
        contract.setContractExpiryDate(parsedExpiryDate);
        contract.setStatus(status);
        
        return contract;
    }
    
    /**
     * Validate business rules
     */
    public static void validateBusinessRules(ContractConfig contract) throws BusinessRuleException {
        Date now = new Date();
        Date effective = contract.getContractEffectiveDate();
        Date expiry = contract.getContractExpiryDate();
        
        // Check if effective date is too far in the past (more than 2 years)
        Calendar cal = Calendar.getInstance();
        cal.add(Calendar.YEAR, -2);
        Date twoYearsAgo = cal.getTime();
        
        if (effective.before(twoYearsAgo)) {
            throw new BusinessRuleException("Contract effective date is too far in the past: " + effective);
        }
        
        // Check if expiry date is before effective date
        if (expiry != null && expiry.before(effective)) {
            throw new BusinessRuleException("Contract expiry date cannot be before effective date");
        }
        
        // Check contract duration (cannot be longer than 10 years)
        if (expiry != null) {
            cal.setTime(effective);
            cal.add(Calendar.YEAR, 10);
            Date maxExpiry = cal.getTime();
            
            if (expiry.after(maxExpiry)) {
                throw new BusinessRuleException("Contract duration cannot exceed 10 years");
            }
        }
        
        // Check if contract ID follows the current year convention
        String year = contract.getContractId().substring(4, 8);
        int contractYear = Integer.parseInt(year);
        int currentYear = Calendar.getInstance().get(Calendar.YEAR);
        
        if (Math.abs(contractYear - currentYear) > 1) {
            throw new BusinessRuleException("Contract year in ID should be within 1 year of current year");
        }
    }
    
    /**
     * Custom exception for business rule violations
     */
    static class BusinessRuleException extends Exception {
        public BusinessRuleException(String message) {
            super(message);
        }
        
        public BusinessRuleException(String message, Throwable cause) {
            super(message, cause);
        }
    }
    
    /**
     * Result tracking class
     */
    static class ProcessingResult {
        private List<ContractConfig> successfulContracts = new ArrayList<>();
        private List<String> errors = new ArrayList<>();
        private long startTime;
        private long endTime;
        
        public ProcessingResult() {
            this.startTime = System.currentTimeMillis();
        }
        
        public void addSuccess(ContractConfig contract) {
            successfulContracts.add(contract);
        }
        
        public void addError(String error) {
            errors.add(error);
        }
        
        public void complete() {
            this.endTime = System.currentTimeMillis();
        }
        
        public void printSummary() {
            complete();
            
            System.out.println("\n" + "=".repeat(50));
            System.out.println("PROCESSING SUMMARY");
            System.out.println("=".repeat(50));
            System.out.println("Total contracts processed: " + (successfulContracts.size() + errors.size()));
            System.out.println("Successful contracts: " + successfulContracts.size());
            System.out.println("Errors encountered: " + errors.size());
            System.out.println("Processing time: " + (endTime - startTime) + " ms");
            
            if (!errors.isEmpty()) {
                System.out.println("\nError Details:");
                for (int i = 0; i < errors.size(); i++) {
                    System.out.println("  " + (i + 1) + ". " + errors.get(i));
                }
            }
            
            if (!successfulContracts.isEmpty()) {
                System.out.println("\nSuccessful Contracts:");
                for (ContractConfig contract : successfulContracts) {
                    System.out.println("  - " + contract.getContractId() + " (" + contract.getStatus() + ")");
                }
            }
            System.out.println("=".repeat(50));
        }
    }
    
