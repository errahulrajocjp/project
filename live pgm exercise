        try {
            System.out.println("Testing valid contract ID and date...");
            boolean validId = validateContractId("CNT-2024-0001");
            System.out.println("✓ Contract ID validation result: " + validId);
            
            Date validDate = parseEffectiveDate("2024-01-15");
            System.out.println("✓ Date parsing result: " + validDate);
            
        } catch (Exception e) {
            System.out.println("✗ Exception caught: " + e.getClass().getSimpleName() + " - " + e.getMessage());
            e.printStackTrace();
        }
        
        // Test Case 2: Null contract ID - Will cause NullPointerException
        System.out.println("\n=== Test Case 2: Null Contract ID ===");
        try {
            System.out.println("Testing null contract ID...");
            boolean validId = validateContractId(null);
            System.out.println("Contract ID validation result: " + validId);
        } catch (Exception e) {
            System.out.println("✗ Exception caught: " + e.getClass().getSimpleName() + " - " + e.getMessage());
            System.out.println("Program crashed! Cannot continue with this approach.");
        }
        
        // Test Case 3: Invalid date format - Will cause ParseException
        System.out.println("\n=== Test Case 3: Invalid Date Format ===");
        try {
            System.out.println("Testing invalid date format...");
            Date invalidDate = parseEffectiveDate("INVALID_DATE");
