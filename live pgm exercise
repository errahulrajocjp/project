import java.text.ParseException;
import java.text.SimpleDateFormat;
import java.util.Arrays;
import java.util.Date;

class Exercise2Solution {
    
    /**
     * Safe contract ID validation WITH exception handling
     */
    public static boolean validateContractIdSafely(String contractId) {
        try {
            System.out.println("    Validating contract ID: " + contractId);
            
            if (contractId == null) {
                System.out.println("    ✗ Contract ID is null");
                return false;
            }
            
            String[] parts = contractId.split("-");
            
            if (parts.length != 3) {
                System.out.println("    ✗ Contract ID format invalid - wrong number of parts");
                return false;
            }
            
            String prefix = parts[0];
            String year = parts[1];
            String sequence = parts[2];
            
            // Check prefix
            if (!"CNT".equals(prefix)) {
                System.out.println("    ✗ Invalid prefix: " + prefix);
                return false;
            }
            
            // Check year (4 digits)
            if (year.length() != 4) {
                System.out.println("    ✗ Year must be 4 digits: " + year);
                return false;
            }
            
            int yearValue = Integer.parseInt(year);  // Can throw NumberFormatException
            
            if (yearValue < 2020 || yearValue > 2030) {
                System.out.println("    ✗ Year out of valid range: " + yearValue);
                return false;
            }
            
            // Check sequence (4 digits)
            if (sequence.length() != 4) {
                System.out.println("    ✗ Sequence must be 4 digits: " + sequence);
                return false;
            }
            
            int sequenceValue = Integer.parseInt(sequence);  // Can throw NumberFormatException
            
            System.out.println("    ✓ Contract ID is valid");
            return true;
            
        } catch (NumberFormatException e) {
            System.out.println("    ✗ NumberFormatException: Invalid numeric format in contract ID");
            return false;
        } catch (Exception e) {
            System.out.println("    ✗ Unexpected exception: " + e.getMessage());
            return false;
        }
    }
    
    /**
     * Safe date parsing WITH exception handling
     */
    public static Date parseEffectiveDateSafely(String dateString) {
        try {
            System.out.println("    Parsing date: " + dateString);
            
            if (dateString == null || dateString.trim().isEmpty()) {
                System.out.println("    ✗ Date string is null or empty");
                return null;
            }
            
            SimpleDateFormat sdf = new SimpleDateFormat("yyyy-MM-dd");
            sdf.setLenient(false);  // Strict parsing
            Date parsedDate = sdf.parse(dateString.trim());
            
            System.out.println("    ✓ Date parsed successfully: " + parsedDate);
            return parsedDate;
            
        } catch (ParseException e) {
            System.out.println("    ✗ ParseException: Invalid date format - " + e.getMessage());
            return null;
        } catch (Exception e) {
            System.out.println("    ✗ Unexpected exception: " + e.getMessage());
            return null;
        }
    }
    
    /**
     * Safe contract creation WITH comprehensive exception handling
     */
    public static ContractConfig createContractSafely(String contractId, String effectiveDate, 
                                                      String expiryDate, String status) {
        try {
            System.out.println("  Creating contract with ID: " + contractId);
            
            // Validate contract ID
            if (!validateContractIdSafely(contractId)) {
                System.out.println("  ✗ Contract creation failed: Invalid contract ID");
                return null;
            }
            
            // Parse effective date
            Date parsedEffectiveDate = parseEffectiveDateSafely(effectiveDate);
            if (parsedEffectiveDate == null) {
                System.out.println("  ✗ Contract creation failed: Invalid effective date");
                return null;
            }
            
            // Parse expiry date (optional)
            Date parsedExpiryDate = null;
            if (expiryDate != null && !expiryDate.trim().isEmpty()) {
                parsedExpiryDate = parseEffectiveDateSafely(expiryDate);
                if (parsedExpiryDate == null) {
                    System.out.println("  ✗ Contract creation failed: Invalid expiry date");
                    return null;
                }
            }
            
            // Validate status
            if (!isValidStatus(status)) {
                System.out.println("  ✗ Contract creation failed: Invalid status - " + status);
                return null;
            }
            
            // Validate date logic
            if (parsedExpiryDate != null && parsedExpiryDate.before(parsedEffectiveDate)) {
                System.out.println("  ✗ Contract creation failed: Expiry date before effective date");
                return null;
            }
            
            // Create contract
            ContractConfig contract = new ContractConfig();
            contract.setContractId(contractId);
            contract.setContractEffectiveDate(parsedEffectiveDate);
            contract.setContractExpiryDate(parsedExpiryDate);
            contract.setStatus(status);
            
            System.out.println("  ✓ Contract created successfully");
            return contract;
            
        } catch (IllegalArgumentException e) {
            System.out.println("  ✗ IllegalArgumentException: " + e.getMessage());
            return null;
        } catch (Exception e) {
            System.out.println("  ✗ Unexpected exception during contract creation: " + e.getMessage());
            return null;
        }
    }
    
    /**
     * Validate contract status
     */
    private static boolean isValidStatus(String status) {
        if (status == null) return false;
        return Arrays.asList("ACTIVE", "INACTIVE", "PENDING", "EXPIRED").contains(status.toUpperCase());
    }
    
    /**
     * Enhanced validation with detailed error messages
     */
    public static String validateContractWithDetails(String contractId, String effectiveDate, 
                                                    String expiryDate, String status) {
        try {
            // Validate contract ID
            if (contractId == null) {
                return "Contract ID cannot be null";
            }
            
            if (contractId.trim().isEmpty()) {
                return "Contract ID cannot be empty";
            }
            
            if (!contractId.matches("CNT-\\d{4}-\\d{4}")) {
                return "Invalid contract ID format. Expected: CNT-YYYY-NNNN (e.g., CNT-2024-0001)";
            }
            
            // Validate effective date
            if (effectiveDate == null || effectiveDate.trim().isEmpty()) {
                return "Effective date is required";
            }
            
            Date parsedEffectiveDate = parseEffectiveDateSafely(effectiveDate);
            if (parsedEffectiveDate == null) {
                return "Invalid effective date format. Expected: yyyy-MM-dd";
            }
            
            // Validate expiry date if provided
            Date parsedExpiryDate = null;
            if (expiryDate != null && !expiryDate.trim().isEmpty()) {
                parsedExpiryDate = parseEffectiveDateSafely(expiryDate);
                if (parsedExpiryDate == null) {
                    return "Invalid expiry date format. Expected: yyyy-MM-dd";
                }
                
                if (parsedExpiryDate.before(parsedEffectiveDate)) {
                    return "Expiry date cannot be before effective date";
                }
            }
            
            // Validate status
            if (!isValidStatus(status)) {
                return "Invalid status. Valid values: ACTIVE, INACTIVE, PENDING, EXPIRED";
            }
            
            return "VALID";
            
        } catch (Exception e) {
            return "Validation error: " + e.getMessage();
        }
    }
    
    public static void main(String[] args) {
        System.out.println("=".repeat(60));
        System.out.println("EXERCISE 2: BASIC EXCEPTION HANDLING");
        System.out.println("=".repeat(60));
        
        // Test data (includes problematic data)
        String[][] testData = {
            {"CNT-2024-0001", "2024-01-15", "2024-12-31", "ACTIVE"},      // Valid
            {"CNT-2024-0002", "INVALID_DATE", "2024-12-31", "ACTIVE"},   // Invalid date
            {null, "2024-04-01", "2024-12-31", "ACTIVE"},                // Null contract ID
            {"CNT-2024-0005", "2024-05-01", "2024-06-01", "INVALID_STATUS"}, // Invalid status
            {"WRONG-FORMAT", "2024-06-01", "2024-12-31", "ACTIVE"},      // Wrong ID format
            {"CNT-2024-0006", "2024-07-01", "2024-06-01", "ACTIVE"}      // Expiry before effective
        };
        
        System.out.println("\n=== Testing Safe Contract Creation ===");
        
        for (int i = 0; i < testData.length; i++) {
            String[] data = testData[i];
            System.out.println("\n--- Test " + (i + 1) + " ---");
            System.out.println("Input: " + Arrays.toString(data));
            
            // Test detailed validation
            String validationResult = validateContractWithDetails(data[0], data[1], data[2], data[3]);
            System.out.println("Validation: " + validationResult);
            
            // Test contract creation
            ContractConfig contract = createContractSafely(data[0], data[1], data[2], data[3]);
            
            if (contract != null) {
                System.out.println("Result: ✓ Contract created successfully");
                System.out.println("Contract: " + contract);
            } else {
                System.out.println("Result: ✗ Failed to create contract");
            }
        }
        
        System.out.println("\n" + "=".repeat(60));
        System.out.println("CONCLUSION: With exception handling, the program");
        System.out.println("handles errors gracefully and continues processing!");
        System.out.println("=".repeat(60));
    }
}

