                if (udfArray.size() > 0) {
                    Map<String, Object> paramsMap = (Map<String, Object>) organizedParams.computeIfAbsent("Params", k -> new HashMap<>());
                    Map<String, Object> hookMap = (Map<String, Object>) paramsMap.computeIfAbsent("hook", k -> new HashMap<>());
                    hookMap.put("userDefinedFunctionResources", mapper.convertValue(udfArray, Object.class));
                }
                
                logger.debug("Added userDefinedFunctionResources to Params.hook for task: " + task.getTaskName());
            } catch (Exception e) {
