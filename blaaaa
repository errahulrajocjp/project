private Map<String, Object> organizeParametersByLevel(TaskData task) {
    Map<String, Object> organizedParams = new HashMap<>();
    
    // Fetch task parameters definitions
    Task taskType = taskRepository.findById(task.getTaskId())
            .orElseThrow(() -> new ResourceNotFoundException("Task type not found: " + task.getTaskId()));
    
    List<TaskParam> taskParams = taskParamRepository.findByTask(taskType);
    
    // Process each parameter
    for (Map.Entry<String, String> param : task.getParameters().entrySet()) {
        String paramName = param.getKey();
        String paramValue = param.getValue();
        
        // Skip special parameters (but not the new ones we're handling separately)
        if ("okTo".equals(paramName) || "sqlPath".equals(paramName) || paramName.startsWith("obs")) {
            continue;
        }
        
        // Special handling for these parameters - will be processed separately in generateTaskNode
        if (task.getTaskId().equals("BqTransform") && 
            ("queryParameters".equals(paramName) || 
             "userDefinedFunctionResources".equals(paramName) ||
             "schemaUpdateOptions".equals(paramName) ||
             "connectionProperties".equals(paramName))) {
            continue;
        }
        
        // Skip empty parameters
        if (paramValue == null || paramValue.trim().isEmpty()) {
            continue;
        }
        
        // ... rest of the method ...
    }
    
    return organizedParams;
}
