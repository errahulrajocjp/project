        if (udfResourcesStr != null && !udfResourcesStr.trim().isEmpty()) {
            try {
                ArrayNode udfArray = mapper.createArrayNode();
                String[] pairs = udfResourcesStr.split(",");
                
                for (String pair : pairs) {
                    String[] keyValue = pair.trim().split("=", 2);
                    if (keyValue.length == 2) {
                        ObjectNode udfNode = mapper.createObjectNode();
                        udfNode.put("resourceUri", keyValue[0].trim());
                        udfNode.put("inlineCode", keyValue[1].trim());
                        udfArray.add(udfNode);
