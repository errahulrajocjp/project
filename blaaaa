        }
        
        // Handle schemaUpdateOptions
        String schemaUpdateStr = task.getParameters().get("schemaUpdateOptions");
        if (schemaUpdateStr != null && !schemaUpdateStr.trim().isEmpty()) {
            try {
                ArrayNode schemaArray = mapper.createArrayNode();
                String[] values = schemaUpdateStr.split(",");
                
                for (String value : values) {
                    String trimmedValue = value.trim();
                    if (!trimmedValue.isEmpty()) {
                        schemaArray.add(trimmedValue);
                    }
                }
                
                if (schemaArray.size() > 0) {
                    Map<String, Object> paramsMap = (Map<String, Object>) organizedParams.computeIfAbsent("Params", k -> new HashMap<>());
