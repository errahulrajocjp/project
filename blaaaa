// Special handling for queryParameters in BqTransform tasks
if (task.getTaskId().equals("BqTransform")) {
    String queryParametersStr = task.getParameters().get("queryParameters");
    if (queryParametersStr != null && !queryParametersStr.trim().isEmpty()) {
        try {
            // Parse the queryParameters JSON string
            JsonNode queryParametersNode = mapper.readTree(queryParametersStr);
            
            // Transform flat structure to nested structure if needed
            if (queryParametersNode.isArray()) {
                ArrayNode transformedArray = mapper.createArrayNode();
                
                for (JsonNode paramNode : queryParametersNode) {
                    ObjectNode transformedParam = mapper.createObjectNode();
                    
                    // Get values from flat structure
                    String name = paramNode.has("name") ? paramNode.get("name").asText() : "";
                    String type = paramNode.has("type") ? paramNode.get("type").asText() : "";
                    String value = paramNode.has("value") ? paramNode.get("value").asText() : "";
                    
                    // Create nested structure
                    transformedParam.put("name", name);
                    
                    ObjectNode parameterType = mapper.createObjectNode();
                    parameterType.put("type", type);
                    transformedParam.set("parameterType", parameterType);
                    
                    ObjectNode parameterValue = mapper.createObjectNode();
                    parameterValue.put("value", value);
                    transformedParam.set("parameterValue", parameterValue);
                    
                    transformedArray.add(transformedParam);
                }
                
                // Use the transformed array
                queryParametersNode = transformedArray;
            }
            
            // Get or create the nested path structure for Params.hook
            Map<String, Object> paramsMap = (Map<String, Object>) organizedParams.computeIfAbsent("Params", k -> new HashMap<>());
            Map<String, Object> hookMap = (Map<String, Object>) paramsMap.computeIfAbsent("hook", k -> new HashMap<>());
            
            // Add queryParameters as a proper JSON node
            hookMap.put("queryParameters", mapper.convertValue(queryParametersNode, Object.class));
            
            logger.debug("Added queryParameters to Params.hook for task: " + task.getTaskName());
        } catch (Exception e) {
            logger.warn("Failed to parse queryParameters for task " + task.getTaskName() + ": " + e.getMessage());
        }
    }
}
