@Override
public DagParameterTaskDto addOrUpdateTask(String dagId, String userDagTaskId, String taskId, String taskName, String customTaskId,
        Map<String, String> parameters, MultipartFile sqlFile) {

    // Fetch the DAG
    DagParameter dagParameter = dagParameterRepository.findById(dagId)
            .orElseThrow(() -> new ResourceNotFoundException("DAG not found with ID: " + dagId));

    // Validate task type exists
    Task taskType = taskRepository.findById(taskId)
            .orElseThrow(() -> new ResourceNotFoundException("Task type not found with ID: " + taskId));

    // CRITICAL CHANGE: Check if this is an update operation
    boolean isUpdate = (userDagTaskId != null && !userDagTaskId.isEmpty());
    
    // For new tasks only, perform SQL validation
    if (!isUpdate && TaskTypeConstants.isSqlTaskType(taskId)) {
        // Only validate for NEW tasks, SKIP validation for updates
        boolean hasQuery = parameters != null && parameters.containsKey("query") && !parameters.get("query").isEmpty();
        boolean hasFile = sqlFile != null && !sqlFile.isEmpty();
        
        if (!hasQuery && !hasFile) {
            throw new BadRequestException(taskId + " requires either an SQL query or SQL file.");
        }
    }

    if (isUpdate) {
        // Update existing task - skip SQL validation entirely
        logger.info("Updating existing task - skipping SQL content validation");
        return updateTask(dagParameter, userDagTaskId, taskId, taskName, customTaskId, parameters, sqlFile, "rahul.kumar");
    } else {
        // Add new task
        return addTask(dagParameter, taskId, taskName, customTaskId, parameters, sqlFile, "rahul.kumar");
    }
}
