// Before: This might be incorrectly evaluated
if (!hasQuery && !hasFile && !hasExistingSqlContent) {
    throw new BadRequestException(taskId + " requires either an SQL query or SQL file.");
}

// Refactored for clarity:
if (isUpdate) {
    // For updates, allow if EITHER current request has SQL OR existing task has SQL
    boolean hasSqlContent = hasQuery || hasFile || hasExistingSqlContent;
    if (!hasSqlContent) {
        throw new BadRequestException(taskId + " requires either an SQL query or SQL file.");
    }
} else {
    // For new tasks, require SQL in current request only
    if (!hasQuery && !hasFile) {
        throw new BadRequestException(taskId + " requires either an SQL query or SQL file.");
    }
}
