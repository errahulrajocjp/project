<!-- Add this to your pom.xml within the <project> tag -->

<repositories>
    <repository>
        <id>spring-releases</id>
        <name>Spring Releases</name>
        <url>https://oneartfactoryci.verizon.com/artifactory/B6VV_CXP-virtual</url>
        <releases>
            <enabled>true</enabled>
        </releases>
        <snapshots>
            <enabled>false</enabled>
        </snapshots>
    </repository>
    
    <repository>
        <id>verizon-artifactory</id>
        <name>Verizon Artifactory</name>
        <url>https://oneartfactoryci.verizon.com/artifactory/B6VV_CXP-virtual</url>
        <releases>
            <enabled>true</enabled>
        </releases>
        <snapshots>
            <enabled>true</enabled>
        </snapshots>
    </repository>
</repositories>

<pluginRepositories>
    <pluginRepository>
        <id>verizon-plugins</id>
        <name>Verizon Plugin Repository</name>
        <url>https://oneartfactoryci.verizon.com/artifactory/B6VV_CXP-virtual</url>
        <releases>
            <enabled>true</enabled>
        </releases>
        <snapshots>
            <enabled>true</enabled>
        </snapshots>
    </pluginRepository>
</pluginRepositories>

