@Override
public JsonNode generateDpfJson(String dagId) {
    // Fetch the DAG with tasks
    DagParameter dagParameter = dagParameterRepository.findById(dagId)
            .orElseThrow(() -> new ResourceNotFoundException("DAG not found with ID: " + dagId));
    
    ObjectMapper mapper = new ObjectMapper();
    ObjectNode rootNode = mapper.createObjectNode();
    
    // ... other code to build the JSON ...
    
    // 3. Handle Schedule_interval formatting - use a placeholder
    if (dagParameter.getScheduleInterval() != null) {
        String scheduleInterval = dagParameter.getScheduleInterval();
        
        // Use a unique placeholder that won't appear in normal JSON
        if ("Daily".equalsIgnoreCase(scheduleInterval)) {
            rootNode.put("Schedule_interval", "PLACEHOLDER_DAILY");
        } else if ("Weekly".equalsIgnoreCase(scheduleInterval)) {
            rootNode.put("Schedule_interval", "PLACEHOLDER_WEEKLY");
        } else if ("Monthly".equalsIgnoreCase(scheduleInterval)) {
            rootNode.put("Schedule_interval", "PLACEHOLDER_MONTHLY");
        } else {
            rootNode.put("Schedule_interval", scheduleInterval);
        }
    } else {
        rootNode.put("Schedule_interval", "None");
    }
    
    // ... rest of the JSON generation ...
    
    // Generate JSON string with placeholders
    String jsonString = rootNode.toString();
    
    // Replace placeholders with exact desired format (post-processing)
    jsonString = jsonString.replace("\"PLACEHOLDER_DAILY\"", "\"/@daily/\"");
    jsonString = jsonString.replace("\"PLACEHOLDER_WEEKLY\"", "\"/@weekly/\"");
    jsonString = jsonString.replace("\"PLACEHOLDER_MONTHLY\"", "\"/@monthly/\"");
    
    // Convert back to JsonNode
    try {
        return mapper.readTree(jsonString);
    } catch (Exception e) {
        logger.error("Error processing JSON with replacements: " + e.getMessage());
        return rootNode; // Fallback to original
    }
}
